<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,user-scalable=no">
<title>Real Car Drive</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  touch-action:none;
}

body{
  overflow:hidden;
  background:#111;
  font-family:Arial,sans-serif;
}

#game{
  position:relative;
  width:100vw;
  height:100vh;
  overflow:hidden;
  background:#579b45;
}

/* Sky */
.sky{
  position:absolute;
  top:0;
  width:100%;
  height:38%;
  background:linear-gradient(#62c8ff,#c9efff);
}

/* Mountains */
.mountains{
  position:absolute;
  top:24%;
  width:100%;
  height:18%;
  background:
  linear-gradient(135deg,transparent 48%,#55736c 49% 62%,transparent 63%),
  linear-gradient(45deg,transparent 48%,#6d8b80 49% 62%,transparent 63%);
  background-size:45% 100%,45% 100%;
  background-position:left,right;
}

/* Grass */
.grass{
  position:absolute;
  bottom:0;
  width:100%;
  height:64%;
  background:repeating-linear-gradient(
    90deg,
    #438c37 0px,
    #438c37 30px,
    #4b963e 31px,
    #4b963e 60px
  );
}

/* Road */
.road{
  position:absolute;
  top:30%;
  left:50%;
  transform:translateX(-50%);
  width:72%;
  height:70%;
  background:#444;
  overflow:hidden;
  border-left:9px solid #eee;
  border-right:9px solid #eee;
  box-shadow:0 0 20px #222;
}

/* Road center lines */
.lines{
  position:absolute;
  left:50%;
  transform:translateX(-50%);
  width:10px;
  height:100%;
  background:repeating-linear-gradient(
    to bottom,
    white 0px,
    white 80px,
    transparent 80px,
    transparent 150px
  );
  animation:roadMove .35s linear infinite;
}

@keyframes roadMove{
  from{background-position:0 0}
  to{background-position:0 150px}
}

/* Side lines */
.road:before,
.road:after{
  content:"";
  position:absolute;
  top:0;
  width:7px;
  height:100%;
  background:#ddd;
}

.road:before{left:27%}
.road:after{right:27%}

/* Player car */
#player{
  position:absolute;
  width:70px;
  height:125px;
  left:50%;
  bottom:65px;
  transform:translateX(-50%);
  z-index:10;
  transition:left .08s linear;
}

.car-body{
  position:absolute;
  width:100%;
  height:100%;
  background:linear-gradient(90deg,#9b0000,#ff2020,#8d0000);
  border-radius:18px 18px 12px 12px;
  box-shadow:0 8px 12px #111;
}

.car-window{
  position:absolute;
  left:11px;
  top:17px;
  width:48px;
  height:38px;
  background:linear-gradient(135deg,#b9ecff,#163c52);
  border-radius:10px 10px 5px 5px;
}

.car-window2{
  position:absolute;
  left:11px;
  top:60px;
  width:48px;
  height:24px;
  background:#182d3a;
  border-radius:5px;
}

.light{
  position:absolute;
  width:13px;
  height:8px;
  background:#fff7a0;
  border-radius:5px;
  bottom:8px;
}

.light.left{left:9px}
.light.right{right:9px}

.wheel{
  position:absolute;
  width:13px;
  height:32px;
  background:#111;
  border-radius:8px;
}

.wheel.l1{left:-7px;top:25px}
.wheel.l2{left:-7px;bottom:25px}
.wheel.r1{right:-7px;top:25px}
.wheel.r2{right:-7px;bottom:25px}

/* Traffic */
.enemy{
  position:absolute;
  width:65px;
  height:115px;
  z-index:8;
  border-radius:15px;
  background:linear-gradient(90deg,#152b8a,#4385ff,#12256f);
  box-shadow:0 6px 10px #111;
}

.enemy:before{
  content:"";
  position:absolute;
  left:10px;
  top:15px;
  width:45px;
  height:35px;
  background:#b7eaff;
  border-radius:9px;
}

.enemy:after{
  content:"";
  position:absolute;
  left:10px;
  top:57px;
  width:45px;
  height:23px;
  background:#142333;
  border-radius:5px;
}

/* Coins */
.coin{
  position:absolute;
  width:30px;
  height:30px;
  border-radius:50%;
  background:radial-gradient(circle,#fff08a 0 15%,#ffd000 16% 65%,#d69200 66%);
  border:3px solid #fff0a0;
  z-index:7;
  box-shadow:0 0 12px #ffd000;
}

/* HUD */
#hud{
  position:absolute;
  top:15px;
  left:15px;
  right:15px;
  z-index:50;
  display:flex;
  justify-content:space-between;
  color:white;
  font-size:18px;
  font-weight:bold;
  text-shadow:2px 2px 3px #000;
}

#speed{
  position:absolute;
  top:52px;
  left:15px;
  z-index:50;
  color:white;
  font-size:16px;
  font-weight:bold;
  text-shadow:2px 2px 3px #000;
}

/* Controls */
.controls{
  position:absolute;
  bottom:15px;
  left:0;
  width:100%;
  display:flex;
  justify-content:center;
  gap:35px;
  z-index:100;
}

.btn{
  width:75px;
  height:65px;
  border:2px solid white;
  border-radius:18px;
  background:rgba(0,0,0,.55);
  color:white;
  font-size:30px;
  font-weight:bold;
}

.btn:active{
  background:rgba(255,255,255,.35);
}

/* Start / Game Over */
#menu{
  position:absolute;
  inset:0;
  z-index:200;
  background:rgba(0,0,0,.72);
  display:flex;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  color:white;
  text-align:center;
}

#menu h1{
  font-size:42px;
  margin-bottom:10px;
  text-shadow:0 3px 8px #000;
}

#menu p{
  font-size:17px;
  margin-bottom:25px;
}

#startBtn{
  padding:15px 40px;
  border:none;
  border-radius:12px;
  background:#e51b23;
  color:white;
  font-size:20px;
  font-weight:bold;
}

.hidden{
  display:none!important;
}

/* Mobile */
@media(max-width:600px){
  .road{
    width:82%;
  }

  #menu h1{
    font-size:34px;
  }
}
</style>
</head>

<body>

<div id="game">

  <div class="sky"></div>
  <div class="mountains"></div>
  <div class="grass"></div>

  <div class="road" id="road">
    <div class="lines"></div>
  </div>

  <div id="player">
    <div class="car-body"></div>
    <div class="car-window"></div>
    <div class="car-window2"></div>

    <div class="wheel l1"></div>
    <div class="wheel l2"></div>
    <div class="wheel r1"></div>
    <div class="wheel r2"></div>

    <div class="light left"></div>
    <div class="light right"></div>
  </div>

  <div id="hud">
    <div>🏆 Score: <span id="score">0</span></div>
    <div>🪙 <span id="coins">0</span></div>
  </div>

  <div id="speed">Speed: <span id="speedValue">80</span> km/h</div>

  <div class="controls">
    <button class="btn" id="left">◀</button>
    <button class="btn" id="right">▶</button>
  </div>

  <div id="menu">
    <h1 id="title">🚗 REAL CAR DRIVE</h1>
    <p id="message">Dodge traffic and collect coins!</p>
    <button id="startBtn">START GAME</button>
  </div>

</div>

<script>

const game = document.getElementById("game");
const road = document.getElementById("road");
const player = document.getElementById("player");

const scoreText = document.getElementById("score");
const coinText = document.getElementById("coins");
const speedText = document.getElementById("speedValue");

const menu = document.getElementById("menu");
const title = document.getElementById("title");
const message = document.getElementById("message");
const startBtn = document.getElementById("startBtn");

const leftBtn = document.getElementById("left");
const rightBtn = document.getElementById("right");

let playing = false;
let score = 0;
let coins = 0;
let speed = 5;

let playerX = 0;
let enemies = [];
let coinObjects = [];

let roadLeft = 0;
let roadWidth = 0;

let keys = {
  left:false,
  right:false
};

/* Start */
startBtn.addEventListener("click",startGame);

function startGame(){

  playing = true;

  score = 0;
  coins = 0;
  speed = 5;

  scoreText.textContent = "0";
  coinText.textContent = "0";

  menu.classList.add("hidden");

  enemies.forEach(e => e.remove());
  coinObjects.forEach(c => c.remove());

  enemies = [];
  coinObjects = [];

  roadLeft = road.offsetLeft;
  roadWidth = road.offsetWidth;

  playerX = roadLeft + roadWidth/2 - player.offsetWidth/2;

  player.style.left = playerX + "px";

  requestAnimationFrame(gameLoop);

  setTimeout(spawnEnemy,800);
  setTimeout(spawnCoin,1200);
}

/* Keyboard */
document.addEventListener("keydown",e=>{
  if(e.key==="ArrowLeft" || e.key==="a"){
    keys.left=true;
  }

  if(e.key==="ArrowRight" || e.key==="d"){
    keys.right=true;
  }
});

document.addEventListener("keyup",e=>{
  if(e.key==="ArrowLeft" || e.key==="a"){
    keys.left=false;
  }

  if(e.key==="ArrowRight" || e.key==="d"){
    keys.right=false;
  }
});

/* Touch buttons */

function pressLeft(e){
  e.preventDefault();
  keys.left=true;
}

function releaseLeft(e){
  e.preventDefault();
  keys.left=false;
}

function pressRight(e){
  e.preventDefault();
  keys.right=true;
}

function releaseRight(e){
  e.preventDefault();
  keys.right=false;
}

leftBtn.addEventListener("touchstart",pressLeft);
leftBtn.addEventListener("touchend",releaseLeft);
leftBtn.addEventListener("mousedown",pressLeft);
leftBtn.addEventListener("mouseup",releaseLeft);

rightBtn.addEventListener("touchstart",pressRight);
rightBtn.addEventListener("touchend",releaseRight);
rightBtn.addEventListener("mousedown",pressRight);
rightBtn.addEventListener("mouseup",releaseRight);

/* Enemy */

function spawnEnemy(){

  if(!playing) return;

  const enemy = document.createElement("div");

  enemy.className="enemy";

  const lanes = [
    .18,
    .39,
    .61,
    .82
  ];

  const lane = lanes[Math.floor(Math.random()*lanes.length)];

  const x =
    roadLeft +
    roadWidth*lane -
    enemy.offsetWidth/2;

  enemy.style.left=x+"px";
  enemy.style.top="-130px";

  game.appendChild(enemy);

  enemies.push({
    el:enemy,
    x:x,
    y:-130
  });

  const delay = Math.max(550,1200-speed*70);

  setTimeout(spawnEnemy,delay);
}

/* Coin */

function spawnCoin(){

  if(!playing) return;

  const coin = document.createElement("div");

  coin.className="coin";

  const lanes=[
    .18,
    .39,
    .61,
    .82
  ];

  const lane=lanes[Math.floor(Math.random()*lanes.length)];

  const x =
    roadLeft +
    roadWidth*lane -
    15;

  coin.style.left=x+"px";
  coin.style.top="-50px";

  game.appendChild(coin);

  coinObjects.push({
    el:coin,
    x:x,
    y:-50
  });

  setTimeout(spawnCoin,1400);
}

/* Game loop */

function gameLoop(){

  if(!playing) return;

  /* Player movement */

  if(keys.left){
    playerX -= 7;
  }

  if(keys.right){
    playerX += 7;
  }

  const minX = roadLeft + 15;
  const maxX =
    roadLeft +
    roadWidth -
    player.offsetWidth -
    15;

  if(playerX<minX) playerX=minX;
  if(playerX>maxX) playerX=maxX;

  player.style.left=playerX+"px";

  /* Enemy movement */

  enemies.forEach((enemy,index)=>{

    enemy.y += speed;

    enemy.el.style.top=enemy.y+"px";

    if(checkCollision(
      player,
      enemy.el
    )){
      gameOver();
    }

    if(enemy.y>window.innerHeight+150){

      enemy.el.remove();
      enemies.splice(index,1);

      score++;

      scoreText.textContent=score;

      if(score%10===0){
        speed+=.6;
      }
    }
  });

  /* Coins */

  coinObjects.forEach((coin,index)=>{

    coin.y += speed;

    coin.el.style.top=coin.y+"px";

    if(checkCollision(
      player,
      coin.el
    )){

      coins++;

      coinText.textContent=coins;

      score+=5;

      scoreText.textContent=score;

      coin.el.remove();
      coinObjects.splice(index,1);
    }

    if(coin.y>window.innerHeight+50){

      coin.el.remove();
      coinObjects.splice(index,1);
    }

  });

  speedText.textContent=
    Math.floor(80 + speed*10);

  requestAnimationFrame(gameLoop);
}

/* Collision */

function checkCollision(a,b){

  const r1=a.getBoundingClientRect();
  const r2=b.getBoundingClientRect();

  return !(
    r1.bottom < r2.top ||
    r1.top > r2.bottom ||
    r1.right < r2.left ||
    r1.left > r2.right
  );
}

/* Game over */

function gameOver(){

  if(!playing) return;

  playing=false;

  title.textContent="💥 GAME OVER";

  message.innerHTML=
    "Score: <b>"+score+
    "</b><br>Coins: <b>"+coins+"</b>";

  startBtn.textContent="PLAY AGAIN";

  menu.classList.remove("hidden");
}

</script>

</body>
</html>
